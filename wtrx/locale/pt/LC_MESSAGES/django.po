msgid "Type your heading as an H2 at the top, then optional supporting copy."
msgstr ""
"Escreva seu título como H2 no topo e, abaixo, o texto de apoio opcional."

#: blocks/__init__.py:2044
msgid "Alignment"
msgstr "Alinhamento"

