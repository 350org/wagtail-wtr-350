msgid "Anchor"
msgstr "Âncora"

#: blocks/__init__.py:941 blocks/__init__.py:2075
msgid ""
"Jump to a block on this same page, by its Anchor ID and without the # symbol"
" (e.g. 'petition'). Set only one of the three link fields."
msgstr ""
"Vai para um bloco desta mesma página, pelo ID da âncora e sem o símbolo # "
"(por exemplo, “petition”). Preencha apenas um dos três campos de link."

#: blocks/__init__.py:949
msgid "Style"
msgstr "Estilo"

#: blocks/__init__.py:954
msgid "Size"
msgstr "Tamanho"

