msgstr "Label tombol ajakan bertindak pada kartu."

#: blocks/__init__.py:1254 blocks/__init__.py:1282 blocks/__init__.py:1833
msgid "Card"
msgstr "Kartu"

#: blocks/__init__.py:1257
msgid ""
"A single linked card: heading, short description, optional image, tag and "
"icon. Usually reached for via Card Grid, which lays several out together."
msgstr ""
"Satu kartu bertautan: judul, deskripsi singkat, serta gambar, label, dan "
"ikon opsional. Biasanya dipakai lewat Kisi Kartu, yang menata beberapa kartu "
"sekaligus."

#: blocks/__init__.py:1290
msgid "Name"
msgstr "Nama"

#: blocks/__init__.py:1293
msgid "Role / title"
msgstr "Peran / jabatan"

#: blocks/__init__.py:1297
msgid "Photo"
msgstr "Foto"

#: blocks/__init__.py:1301
msgid "Bio"
msgstr "Biodata"

