msgid "Side by side"
msgstr "Berdampingan"

#: blocks/__init__.py:3188 blocks/__init__.py:3281
msgid "Stacked vertically"
msgstr "Bertumpuk vertikal"

#: blocks/__init__.py:3193 blocks/__init__.py:3286
