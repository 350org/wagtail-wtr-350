msgid "Text"
msgstr "Teks"

#: blocks/__init__.py:735
msgid ""
"Rich text: paragraphs, headings, lists, bold/italic and links. The default "
"choice for ordinary body copy."
msgstr ""
"Teks kaya: paragraf, judul, daftar, tebal/miring, dan tautan. Pilihan bawaan "
"untuk badan teks biasa."

#: blocks/__init__.py:763
msgid "Lead paragraph"
msgstr "Paragraf pembuka"

#: blocks/__init__.py:766
msgid ""
"A larger introductory paragraph for opening a page or section. Bold/italic/"
"links only — use a regular Text block for headings or lists."
msgstr ""
"Paragraf pembuka berukuran lebih besar untuk membuka halaman atau bagian. "
"Hanya tebal/miring/tautan — gunakan blok Teks biasa untuk judul atau daftar."

#: blocks/__init__.py:774
msgid ""
"<p>A short, larger opening statement that sits above the regular body copy.</"
"p>"
msgstr ""
"<p>Pernyataan pembuka singkat berukuran lebih besar yang ditempatkan di atas "
"badan teks.</p>"

