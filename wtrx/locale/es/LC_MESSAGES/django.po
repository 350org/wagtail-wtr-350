#: blocks/__init__.py:583
msgid "A future powered by people"
msgstr "Un futuro impulsado por la gente"

#: blocks/__init__.py:593 blocks/__init__.py:684
msgid "Jane Doe"
msgstr "Juana Pérez"

#: blocks/__init__.py:594 blocks/__init__.py:685
msgid "Regional Organising Lead"
msgstr "Responsable de organización regional"

#: blocks/__init__.py:597
msgid ""
"Jane coordinates campaign partners across the region and has organised with "
"the climate movement for over a decade."
msgstr ""
"Juana coordina a las organizaciones aliadas de campaña en la región y lleva "
"más de una década organizando dentro del movimiento climático."

#: blocks/__init__.py:665
#, python-format
msgid "Partner Organization %(n)d"
msgstr "Organización aliada %(n)d"

#: blocks/__init__.py:713
msgid "Sign up"
msgstr "Suscribirse"

#: blocks/__init__.py:732 blocks/__init__.py:3355
msgid "Text"
msgstr "Texto"

#: blocks/__init__.py:735
msgid ""
"Rich text: paragraphs, headings, lists, bold/italic and links. The default "
"choice for ordinary body copy."
msgstr ""
"Texto enriquecido: párrafos, títulos, listas, negrita/cursiva y enlaces. La "
"opción predeterminada para el cuerpo del texto."

#: blocks/__init__.py:763
msgid "Lead paragraph"
msgstr "Párrafo de entrada"

#: blocks/__init__.py:766
msgid ""
"A larger introductory paragraph for opening a page or section. Bold/italic/"
"links only — use a regular Text block for headings or lists."
msgstr ""
"Un párrafo introductorio más grande para abrir una página o sección. Solo "
"negrita/cursiva/enlaces: usa un bloque de Texto normal para títulos o listas."

#: blocks/__init__.py:774
msgid ""
"<p>A short, larger opening statement that sits above the regular body copy.</"
"p>"
msgstr ""
"<p>Una declaración de apertura breve y de mayor tamaño, situada sobre el "
"cuerpo del texto.</p>"

#: blocks/__init__.py:806 blocks/__init__.py:812 blocks/__init__.py:1429
#: blocks/__init__.py:1642 blocks/__init__.py:1732 blocks/__init__.py:1784
#: blocks/__init__.py:1850 blocks/__init__.py:2279
msgid "Heading"
msgstr "Título"

#: blocks/__init__.py:807
msgid "Section heading, rendered as a centered H2."
msgstr "Título de sección, renderizado como H2."

#: blocks/__init__.py:815
msgid ""
"A standalone centered section heading (H2), matching the heading style used "
"above card rows."
msgstr ""
"Un título de sección centrado e independiente (H2), con el mismo estilo que "
"el título que aparece sobre las filas de tarjetas."

#: blocks/__init__.py:818
msgid "What we're working on"
msgstr "En qué estamos trabajando"

#: blocks/__init__.py:834 blocks/__init__.py:851 blocks/__init__.py:1211
#: blocks/__init__.py:1277 blocks/__init__.py:1468 blocks/__init__.py:1480
#: blocks/__init__.py:1853 blocks/__init__.py:1915 blocks/__init__.py:2040
#: blocks/__init__.py:2335 blocks/__init__.py:2726 blocks/__init__.py:3200
#: blocks/__init__.py:3293 blocks/__init__.py:3482
msgid "Image"
msgstr "Imagen"

#: blocks/__init__.py:837 blocks/__init__.py:1471
msgid "Alt text"
msgstr "Texto alternativo"

#: blocks/__init__.py:839 blocks/__init__.py:1473
msgid ""
"Overrides the image description for screen readers. Leave blank to use the "
"description set on the image itself."
msgstr ""
"Sustituye la descripción de la imagen para lectores de pantalla. Déjalo en "
"blanco para usar la descripción de la propia imagen."

#: blocks/__init__.py:845 blocks/__init__.py:875
msgid "Caption"
msgstr "Pie de foto"

#: blocks/__init__.py:846
msgid "Optional caption displayed below the image."
msgstr "Pie de foto opcional que se muestra debajo de la imagen."

#: blocks/__init__.py:865
msgid "Embed URL"
msgstr "URL de inserción"

#: blocks/__init__.py:866
msgid "YouTube, Vimeo, or other oEmbed-compatible URL."
msgstr "YouTube, Vimeo u otra URL compatible con oEmbed."

#: blocks/__init__.py:870 blocks/__init__.py:2340
msgid "Media file"
msgstr "Archivo multimedia"

#: blocks/__init__.py:871
msgid "An uploaded video file from the media library."
msgstr "Un archivo de vídeo subido desde la biblioteca multimedia."

#: blocks/__init__.py:884
msgid "Provide either an embed URL or a media file."
msgstr "Indica una URL de inserción o un archivo multimedia."

#: blocks/__init__.py:889
msgid "Provide either an embed URL or a media file, not both."
msgstr "Indica una URL de inserción o un archivo multimedia, pero no ambos."

#: blocks/__init__.py:899
msgid "Video"
msgstr "Vídeo"

#: blocks/__init__.py:926 blocks/__init__.py:2058 blocks/__init__.py:2118
#: blocks/__init__.py:2222 blocks/__init__.py:2519 blocks/__init__.py:2842
msgid "Button text"
msgstr "Texto del botón"

#: blocks/__init__.py:929 blocks/__init__.py:1215 blocks/__init__.py:1690
