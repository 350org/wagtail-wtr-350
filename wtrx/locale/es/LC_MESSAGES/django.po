msgstr "enlaces del pie de página minimalista"

#: site_settings.py:703
msgid "Flat list of links displayed inline in the minimal footer layout."
msgstr ""
"Lista simple de enlaces que se muestran en línea en el diseño minimalista "
"del pie de página."

#: site_settings.py:710
msgid "copyright text"
msgstr "texto de copyright"

#: site_settings.py:712
