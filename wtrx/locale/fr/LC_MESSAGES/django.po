#: blocks/__init__.py:732 blocks/__init__.py:3355
msgid "Text"
msgstr "Texte"

#: blocks/__init__.py:735
msgid ""
"Rich text: paragraphs, headings, lists, bold/italic and links. The default "
"choice for ordinary body copy."
msgstr ""
"Texte enrichi : paragraphes, titres, listes, gras/italique et liens. Le "
"choix par défaut pour le corps de texte ordinaire."

#: blocks/__init__.py:763
msgid "Lead paragraph"
msgstr "Paragraphe d’introduction"

#: blocks/__init__.py:766
msgid ""
"A larger introductory paragraph for opening a page or section. "
"Bold/italic/links only — use a regular Text block for headings or lists."
msgstr ""
"Un paragraphe d’introduction plus grand pour ouvrir une page ou une section."
" Gras/italique/liens uniquement — utilisez un bloc Texte ordinaire pour les "
"titres ou les listes."

#: blocks/__init__.py:774
msgid ""
"<p>A short, larger opening statement that sits above the regular body "
"copy.</p>"
msgstr ""
"<p>Une courte déclaration d’ouverture, en plus grand, placée au-dessus du "
"corps de texte.</p>"

