msgid "Content"
msgstr "Contenu"

#: blocks/__init__.py:1207
msgid "Type your heading as an H3 at the top, then optional supporting copy."
msgstr ""
"Saisissez votre titre en H3 en haut, puis un texte d’accompagnement "
"facultatif."

#: blocks/__init__.py:1216 blocks/__init__.py:1962 blocks/__init__.py:2064
#: blocks/__init__.py:2124 blocks/__init__.py:2353 blocks/__init__.py:2441
#: blocks/__init__.py:3359
msgid "Internal link. Set either this or Link URL, not both."
msgstr ""
"Lien interne. Renseignez soit ce champ, soit l’URL du lien, mais pas les "
"deux."

#: blocks/__init__.py:1221 blocks/__init__.py:1967 blocks/__init__.py:2129
#: blocks/__init__.py:2358 blocks/__init__.py:2446 blocks/__init__.py:3364
msgid "External link. Set either this or Link page, not both."
msgstr ""
"Lien externe. Renseignez soit ce champ, soit la page de destination, mais "
"pas les deux."

#: blocks/__init__.py:1226 blocks/__init__.py:1956 blocks/__init__.py:2347
#: blocks/__init__.py:2435 site_settings.py:44 site_settings.py:55
#: site_settings.py:66 site_settings.py:89
msgid "Link text"
msgstr "Texte du lien"

#: blocks/__init__.py:1227
msgid "Label for the card's CTA button."
msgstr "Libellé du bouton d’appel à l’action de la carte."

#: blocks/__init__.py:1254 blocks/__init__.py:1282 blocks/__init__.py:1833
msgid "Card"
msgstr "Carte"

#: blocks/__init__.py:1257
msgid ""
"A single linked card: heading, short description, optional image, tag and "
"icon. Usually reached for via Card Grid, which lays several out together."
msgstr ""
"Une carte cliquable : titre, courte description, image, étiquette et icône "
"facultatives. On y accède généralement via la Grille de cartes, qui en "
"dispose plusieurs ensemble."

#: blocks/__init__.py:1290
msgid "Name"
msgstr "Nom"

#: blocks/__init__.py:1293
msgid "Role / title"
msgstr "Rôle / fonction"

#: blocks/__init__.py:1297
msgid "Photo"
msgstr "Photo"

#: blocks/__init__.py:1301
msgid "Bio"
msgstr "Biographie"

#: blocks/__init__.py:1305
#: templates/wtrx/components/streamfield/blocks/signup_action_network_block.html:31
#: templates/wtrx/components/streamfield/blocks/signup_wagtail_forms_block.html:53
msgid "Email"
msgstr "Courriel"

#: blocks/__init__.py:1309
msgid "Phone"
msgstr "Téléphone"

#: blocks/__init__.py:1313 templates/wtrx/components/person_card.html:115
#: templates/wtrx/components/person_card.html:132
msgid "Website"
msgstr "Site web"

#: blocks/__init__.py:1325
msgid "Person"
msgstr "Personne"

#: blocks/__init__.py:1328
msgid ""
"A person: photo, name, role and short bio, with optional contact details. "
"Use for staff, spokespeople or board listings."
msgstr ""
"Une personne : photo, nom, rôle et courte biographie, avec des coordonnées "
"facultatives. À utiliser pour l’équipe, les porte-parole ou le conseil "
"d’administration."

#: blocks/__init__.py:1390
msgid "Title"
msgstr "Titre"

#: blocks/__init__.py:1395
msgid "Accordion item"
msgstr "Élément d’accordéon"

#: blocks/__init__.py:1430 blocks/__init__.py:1643 blocks/__init__.py:2280
msgid "Section heading, rendered as an H2."
msgstr "Titre de section, rendu en H2."

#: blocks/__init__.py:1436 blocks/__init__.py:1857 blocks/__init__.py:2134
msgid "Cards"
msgstr "Cartes"

#: blocks/__init__.py:1451
msgid "Card Grid"
msgstr "Grille de cartes"

#: blocks/__init__.py:1454
msgid ""
"An auto-responsive grid of 2-12 linked cards, laid out automatically — never"
" a lone card on its own row. There are no column controls."
msgstr ""
"Une grille adaptative de 2 à 12 cartes cliquables, disposées automatiquement"
" — jamais une carte seule sur sa propre ligne. Il n’y a pas de réglage de "
"colonnes."

#: blocks/__init__.py:1649
msgid "Images"
msgstr "Images"

#: blocks/__init__.py:1664
msgid "Image Grid"
msgstr "Grille d’images"

#: blocks/__init__.py:1667
msgid ""
"An auto-responsive grid of 2-24 photos, cropped to a consistent square "
"shape. No per-image captions. There are no column controls."
msgstr ""
"Une grille adaptative de 2 à 24 photos, recadrées au même format carré. Pas "
"de légende par image. Il n’y a pas de réglage de colonnes."

#: blocks/__init__.py:1680 blocks/__init__.py:1708
msgid "Logo"
msgstr "Logo"

#: blocks/__init__.py:1682
msgid "Organization name"
msgstr "Nom de l’organisation"

#: blocks/__init__.py:1684
msgid ""
"Used as alt text if the image has no description, and as the logo's "
"accessible label if it links out."
msgstr ""
"Utilisé comme texte alternatif si l’image n’a pas de description, et comme "
"libellé accessible du logo s’il renvoie vers un lien."

#: blocks/__init__.py:1691
msgid "Internal page link. Set only one of the two link fields."
msgstr ""
"Lien vers une page interne. Ne renseignez qu’un seul des deux champs de "
"lien."

#: blocks/__init__.py:1696
msgid "External link. Set only one of the two link fields."
msgstr "Lien externe. Ne renseignez qu’un seul des deux champs de lien."

#: blocks/__init__.py:1737 site_settings.py:468
msgid "Logos"
msgstr "Logos"

#: blocks/__init__.py:1751
msgid "Logo Grid"
msgstr "Grille de logos"

#: blocks/__init__.py:1754
msgid ""
"A grid of 2-30 partner/funder logos, sized consistently. Logos may "
"optionally link out."
msgstr ""
"Une grille de 2 à 30 logos de partenaires ou de bailleurs, dimensionnés de "
"façon homogène. Les logos peuvent renvoyer vers un lien."

#: blocks/__init__.py:1789
msgid "People"
msgstr "Personnes"

#: blocks/__init__.py:1801
msgid "Person Card Grid"
msgstr "Grille de cartes de personnes"

#: blocks/__init__.py:1804
msgid ""
"A grid of up to 12 people, laid out automatically — never a lone card on its"
" own row. There are no column controls."
msgstr ""
"Une grille d’un maximum de 12 personnes, disposées automatiquement — jamais "
"une carte seule sur sa propre ligne. Il n’y a pas de réglage de colonnes."

#: blocks/__init__.py:1828
msgid "Type your heading as an H3 at the top, then the supporting copy."
msgstr "Saisissez votre titre en H3 en haut, puis le texte d’accompagnement."

#: blocks/__init__.py:1851
msgid "Centered heading above the image and cards."
msgstr "Titre centré au-dessus de l’image et des cartes."

#: blocks/__init__.py:1862 blocks/__init__.py:1924 blocks/__init__.py:2745
msgid "Image alignment"
msgstr "Alignement de l’image"

#: blocks/__init__.py:1863
msgid "Which side the image sits on — the cards sit on the opposite side."
msgstr "Le côté où se place l’image — les cartes se placent du côté opposé."

#: blocks/__init__.py:1868
msgid "Image Card List"
msgstr "Liste de cartes avec image"

#: blocks/__init__.py:1919
msgid "Type your heading as an H2 at the top, then the body text."
msgstr "Saisissez votre titre en H2 en haut, puis le corps du texte."

#: blocks/__init__.py:1925
msgid "Which side the image sits on — the text sits on the opposite side."
msgstr "Le côté où se place l’image — le texte se place du côté opposé."

#: blocks/__init__.py:1930
msgid "Image size"
msgstr "Taille de l’image"

#: blocks/__init__.py:1931
msgid "How wide the image column is."
msgstr "La largeur de la colonne d’image."

#: blocks/__init__.py:1936
msgid "Crop to square"
msgstr "Recadrer en carré"

#: blocks/__init__.py:1938
msgid ""
"Uncheck to show the image at its natural aspect ratio instead of cropping it"
" to a square — useful for a logo or other image that looks wrong cropped."
msgstr ""
"Décochez pour afficher l’image dans ses proportions d’origine au lieu de la "
"recadrer en carré — utile pour un logo ou toute autre image qui se prête mal"
" au recadrage."

#: blocks/__init__.py:1957 blocks/__init__.py:2348 blocks/__init__.py:2436
msgid "CTA button label. Leave blank to omit the button."
msgstr ""
"Libellé du bouton d’appel à l’action. Laissez vide pour masquer le bouton."

#: blocks/__init__.py:1972
#| msgid "Link text"
msgid "Link style"
msgstr "Texte du lien"

#: blocks/__init__.py:1973
msgid "Button style for the CTA above."
msgstr "Style du bouton d’appel à l’action ci-dessus."

#: blocks/__init__.py:1985
msgid "Image + Text"
msgstr "Image + texte"

#: blocks/__init__.py:2029 blocks/__init__.py:3161 blocks/__init__.py:3263
msgid "Eyebrow"
msgstr "Surtitre"

#: blocks/__init__.py:2031
msgid ""
"Optional short label shown in a pill above the heading, e.g. \"Featured "
"Campaign\". Leave blank to omit the pill."
msgstr ""
"Court libellé facultatif affiché dans une pastille au-dessus du titre, par "
"exemple « Campagne à la une ». Laissez vide pour masquer la pastille."

