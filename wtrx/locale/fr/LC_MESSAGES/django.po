#: blocks/__init__.py:837 blocks/__init__.py:1471
msgid "Alt text"
msgstr "Texte alternatif"

#: blocks/__init__.py:839 blocks/__init__.py:1473
msgid ""
"Overrides the image description for screen readers. Leave blank to use the "
"description set on the image itself."
msgstr ""
"Remplace la description de l’image pour les lecteurs d’écran. Laissez vide "
"pour utiliser la description définie sur l’image elle-même."

#: blocks/__init__.py:845 blocks/__init__.py:875
msgid "Caption"
msgstr "Légende"

#: blocks/__init__.py:846
msgid "Optional caption displayed below the image."
msgstr "Légende facultative affichée sous l’image."

#: blocks/__init__.py:865
msgid "Embed URL"
msgstr "URL d’intégration"

#: blocks/__init__.py:866
msgid "YouTube, Vimeo, or other oEmbed-compatible URL."
msgstr "YouTube, Vimeo ou toute autre URL compatible oEmbed."

#: blocks/__init__.py:870 blocks/__init__.py:2340
msgid "Media file"
msgstr "Fichier multimédia"

#: blocks/__init__.py:871
msgid "An uploaded video file from the media library."
msgstr "Un fichier vidéo téléversé depuis la médiathèque."

#: blocks/__init__.py:884
msgid "Provide either an embed URL or a media file."
msgstr "Renseignez soit une URL d’intégration, soit un fichier multimédia."

#: blocks/__init__.py:889
msgid "Provide either an embed URL or a media file, not both."
msgstr ""
"Renseignez soit une URL d’intégration, soit un fichier multimédia, mais pas "
"les deux."

#: blocks/__init__.py:899
msgid "Video"
msgstr "Vidéo"

