" facultatif et/ou d’une liste à puces ou numérotée."

#: blocks/__init__.py:2451 blocks/__init__.py:3492
msgid "Color"
msgstr "Couleur"

#: blocks/__init__.py:2455
msgid "Background image"
msgstr "Image d’arrière-plan"

