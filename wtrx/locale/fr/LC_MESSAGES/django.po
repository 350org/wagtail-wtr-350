msgid "Section heading, rendered as a centered H2."
msgstr "Titre de section, rendu en H2."

#: blocks/__init__.py:815
msgid ""
"A standalone centered section heading (H2), matching the heading style used "
"above card rows."
msgstr ""
"Un titre de section centré autonome (H2), dans le même style que le titre "
"affiché au-dessus des rangées de cartes."

#: blocks/__init__.py:818
msgid "What we're working on"
msgstr "Ce sur quoi nous travaillons"

#: blocks/__init__.py:834 blocks/__init__.py:851 blocks/__init__.py:1211
