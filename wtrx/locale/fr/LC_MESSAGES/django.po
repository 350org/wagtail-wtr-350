msgid "Link page"
msgstr "Page de destination"

#: blocks/__init__.py:930
msgid "Internal page link. Set only one of the three link fields."
msgstr ""
"Lien vers une page interne. Ne renseignez qu’un seul des trois champs de "
"lien."

#: blocks/__init__.py:934 blocks/__init__.py:1220 blocks/__init__.py:1695
#: blocks/__init__.py:1966 blocks/__init__.py:2068 blocks/__init__.py:2128
#: blocks/__init__.py:2357 blocks/__init__.py:2445 blocks/__init__.py:3363
msgid "Link URL"
msgstr "URL du lien"

#: blocks/__init__.py:935 blocks/__init__.py:2069
msgid "External link. Set only one of the three link fields."
msgstr "Lien externe. Ne renseignez qu’un seul des trois champs de lien."

#: blocks/__init__.py:939 blocks/__init__.py:2073 site_settings.py:68
msgid "Anchor"
msgstr "Ancre"

#: blocks/__init__.py:941 blocks/__init__.py:2075
msgid ""
"Jump to a block on this same page, by its Anchor ID and without the # symbol"
" (e.g. 'petition'). Set only one of the three link fields."
msgstr ""
"Aller à un bloc de cette même page, en indiquant son identifiant d’ancre "
"sans le symbole # (par exemple « petition »). Ne renseignez qu’un seul des "
"trois champs de lien."

#: blocks/__init__.py:949
msgid "Style"
msgstr "Style"

#: blocks/__init__.py:954
msgid "Size"
msgstr "Taille"

#: blocks/__init__.py:964
msgid "Provide a link page, a link URL, or an anchor."
msgstr "Renseignez une page de destination, une URL ou une ancre."

#: blocks/__init__.py:984
msgid "Button"
msgstr "Bouton"

#: blocks/__init__.py:987
msgid ""
"A single call-to-action button. Links to a page on this site, an external "
"URL, or an anchor further down the same page."
msgstr ""
"Un bouton d’appel à l’action unique. Renvoie vers une page de ce site, une "
"URL externe ou une ancre plus bas dans la même page."

#: blocks/__init__.py:991 blocks/__init__.py:1059
#: templates/wtrx/components/streamfield/blocks/card_carousel_block.html:131
msgid "Take action"
msgstr "Passez à l’action"

#: blocks/__init__.py:999
msgid "Horizontal"
msgstr "Horizontal"

#: blocks/__init__.py:1000
msgid "Vertical"
msgstr "Vertical"

#: blocks/__init__.py:1029
msgid "Buttons"
msgstr "Boutons"

#: blocks/__init__.py:1033 blocks/__init__.py:3191 blocks/__init__.py:3284
#: site_settings.py:572
msgid "Layout"
msgstr "Disposition"

#: blocks/__init__.py:1035
msgid ""
"Horizontal lays buttons out in centered rows. Vertical stacks them in a "
"centered column."
msgstr ""
"Horizontal dispose les boutons en rangées centrées. Vertical les empile en "
"colonne centrée."

#: blocks/__init__.py:1050
msgid "Button Group"
msgstr "Groupe de boutons"

#: blocks/__init__.py:1053
msgid ""
"Two or more call-to-action buttons, laid out horizontally or vertically. Use"
" the single Button block instead for one CTA."
msgstr ""
"Deux boutons d’appel à l’action ou plus, disposés horizontalement ou "
"verticalement. Utilisez plutôt le bloc Bouton pour un seul appel à l’action."

#: blocks/__init__.py:1067 blocks/__init__.py:1225
#: templates/wtrx/components/card.html:90
msgid "Learn more"
msgstr "En savoir plus"

#: blocks/__init__.py:1105 validators.py:75
msgid ""
"This HTML appears to have mismatched or unclosed tags — check that every "
"opening tag has a matching closing tag."
msgstr ""
"Ce code HTML semble contenir des balises non appariées ou non fermées — "
"vérifiez que chaque balise ouvrante a bien une balise fermante."

#: blocks/__init__.py:1114
#| msgid "Custom code"
msgid "Custom embed"
msgstr "Code personnalisé"

#: blocks/__init__.py:1120
msgid ""
"Paste in HTML supplied by another service -- an embed, a widget, a snippet "
"of markup. It is rendered exactly as given, so only use it for code you "
"trust. Tag balance is validated on save; markup safety is not."
msgstr ""
"Collez du code HTML fourni par un autre service : une intégration, un "
"widget, un extrait de balisage. Il est rendu tel quel, ne l’utilisez donc "
"que pour du code de confiance. L’équilibre des balises est vérifié à "
"l’enregistrement ; la sécurité du balisage ne l’est pas."

#: blocks/__init__.py:1148
msgid "Table"
msgstr "Tableau"

#: blocks/__init__.py:1151
msgid ""
"A simple data table, edited as a spreadsheet-style grid. The first row and "
"column can each be marked as headers."
msgstr ""
"Un tableau de données simple, modifiable comme une grille de tableur. La "
"première ligne et la première colonne peuvent chacune être définies comme "
"en-têtes."

#: blocks/__init__.py:1194
msgid "Tag"
msgstr "Étiquette"

#: blocks/__init__.py:1195
msgid ""
"Optional short label displayed as a pill above the heading (e.g. 'Global')."
msgstr ""
"Court libellé facultatif affiché sous forme de pastille au-dessus du titre "
"(par exemple « Mondial »)."

#: blocks/__init__.py:1199 site_settings.py:1184
msgid "Icon"
msgstr "Icône"

#: blocks/__init__.py:1201
msgid ""
"Optional small icon image (ideally square) displayed beside the content."
msgstr ""
"Petite image d’icône facultative (idéalement carrée) affichée à côté du "
"contenu."

#: blocks/__init__.py:1206 blocks/__init__.py:1374 blocks/__init__.py:1827
#: blocks/__init__.py:1918 blocks/__init__.py:2037 blocks/__init__.py:2113
