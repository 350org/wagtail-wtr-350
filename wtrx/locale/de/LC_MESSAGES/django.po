msgstr "Text"

#: blocks/__init__.py:729
msgid ""
"Rich text: paragraphs, headings, lists, bold/italic and links. The default "
"choice for ordinary body copy."
msgstr ""
"Rich Text: Absätze, Überschriften, Listen, fett/kursiv und Links. Die "
"Standardwahl für normalen Fließtext."

#: blocks/__init__.py:757
msgid "Lead paragraph"
msgstr "Einleitungsabsatz"

#: blocks/__init__.py:760
msgid ""
"A larger introductory paragraph for opening a page or section. "
"Bold/italic/links only — use a regular Text block for headings or lists."
msgstr ""
"Ein größerer Einleitungsabsatz zum Einstieg in eine Seite oder einen "
"Abschnitt. Nur fett/kursiv/Links — für Überschriften oder Listen einen "
"normalen Textblock verwenden."

#: blocks/__init__.py:768
msgid ""
"<p>A short, larger opening statement that sits above the regular body "
"copy.</p>"
msgstr ""
"<p>Eine kurze, größere Einstiegsaussage über dem normalen Fließtext.</p>"

